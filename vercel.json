{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{*.php,includes/**}",
      "excludeFiles": "{frontend-react/**,node_modules/**,scratch/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|images/|favicon\\.ico).*)",
      "destination": "/api/index.php"
    }
  ]
}
